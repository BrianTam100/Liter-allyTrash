# Copy to .env. Never commit credentials.
# Tiger Cloud connection string from your service's Connect screen.
# Leave blank to use the clearly labelled local SQLite development database.
DATABASE_URL=
# Example: postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
SECRET_KEY=
COOKIE_SECURE=false
# auto picks the paired rover's outgoing Bluetooth port; set e.g. COM3 to force one.
ROVER_SERIAL_PORT=auto
ROVER_BAUD=115200
PI_IP=172.20.8.62
PI_UDP_PORT=5005
# Optional; uses the existing voice_control.py and the laptop microphone.
XAI_API_KEY=
# Optional secret for identified bin-event ingestion from the Pi.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTION_API_KEY=
# Unified dashboard recognition settings. Also available as web_server.py flags.
CLASSIFIER_AUTOLOAD=true
CLASSIFIER_CAMERA=0
CLASSIFIER_LID_ENABLED=false
LID_HOST=
LID_PORT=5006
# Photon Spectrum project Settings (keep secrets server-side).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Same local secret in the dashboard and the Spectrum worker.
SPECTRUM_BRIDGE_KEY=
# Phones in international format or Apple IDs; comma-separated. Empty denies iMessage access.
SPECTRUM_ALLOWED_SENDERS=
SPECTRUM_BACKEND_URL=http://127.0.0.1:8000
# Select imessage or telegram. Telegram needs a bot from @BotFather.
SPECTRUM_PROVIDER=imessage
SPECTRUM_TELEGRAM_BOT_TOKEN=
# Numeric user IDs, comma-separated. Get yours by privately sending /whoami to your bot.
# Empty permits setup commands only, with no access to shared Pilot records.
SPECTRUM_TELEGRAM_ALLOWED_SENDERS=
# Optional: defaults to a stable secret derived from SPECTRUM_BRIDGE_KEY.
SPECTRUM_TELEGRAM_WEBHOOK_SECRET=
# Optional natural conversation using the existing xAI account.
XAI_CHAT_MODEL=grok-4.7

# Gemini powers the separate Sort Guide; xAI powers Rover conversation.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.7-flash
