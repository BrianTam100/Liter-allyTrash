# Copy to .env. Never commit credentials.
# Tiger Cloud connection string from your service's Connect screen.
# Leave blank to use the clearly labelled local SQLite development database.
DATABASE_URL=
# Example: postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
SECRET_KEY=
COOKIE_SECURE=false
ROVER_SERIAL_PORT=COM8
ROVER_BAUD=115200
PI_IP=172.20.8.62
PI_UDP_PORT=5005
# Optional; uses the existing voice_control.py and the laptop microphone.
XAI_API_KEY=
# Optional secret for identified bin-event ingestion from the Pi.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTION_API_KEY=
# Unified dashboard recognition settings. Also available as web_server.py flags.
CLASSIFIER_AUTOLOAD=true
CLASSIFIER_CAMERA=0
CLASSIFIER_LID_ENABLED=false
LID_HOST=
LID_PORT=5006
